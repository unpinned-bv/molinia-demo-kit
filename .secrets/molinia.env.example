# Copy to .secrets/molinia.env and fill in. Tools load it; nothing prints a value.
# The API host, e.g. https://app.molinia.eu. Never the apex molinia.eu: that is
# the marketing site.
MOLINIA_API_URL=PASTE_HERE
# The org's public id (org_...), from the console.
MOLINIA_ORG_ID=PASTE_HERE
# Service account for dbt, ingest and parity (engagement.yml: service_accounts.build).
MOLINIA_API_KEY=rd_sa_PASTE_HERE
# Read-only service account, for the masked read only (service_accounts.readonly).
MOLINIA_READONLY_KEY=rd_sa_PASTE_HERE
