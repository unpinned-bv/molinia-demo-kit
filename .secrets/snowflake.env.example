# Copy to .secrets/snowflake.env and fill in. Key-pair auth: the private key file
# is the secret, and it never leaves .secrets/.
SNOWFLAKE_ACCOUNT=PASTE_HERE
SNOWFLAKE_USER=PASTE_HERE
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=DEMO_WH
SNOWFLAKE_DATABASE=MOLINIA_DEMO
SNOWFLAKE_PRIVATE_KEY_PATH=.secrets/snowflake_rsa_key.p8
